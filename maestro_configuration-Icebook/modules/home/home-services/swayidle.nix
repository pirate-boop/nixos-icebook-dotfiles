#****************************************************************#
# |============================================================| #
# |SWAYIDLE — только гашение экрана + lock строго ПЕРЕД сном    | #
# |============================================================| #
#  5 мин бездействия  → просто гасит экран (без блокировки)      #
#  before-sleep        → hyprlock (пароль ТОЛЬКО при сне/крышке)  #
#                                                                #
#  Засыпание при закрытии крышки рулится через systemd-logind    #
#****************************************************************#
{ pkgs, ... }: {

  services.swayidle = {
    enable = true;

    # Блокируем экран ТОЛЬКО когда система реально ложится спать (например, закрыли крышку)
    events = [
      {
        event = "before-sleep";
        command = "$lock-session-kori";
      }
    ];

    timeouts = [
      # Через 5 минут (300 сек) бездействия просто выключаем мониторы
      # При движении мыши/нажатии клавиши экран загорится обратно БЕЗ пароля
      {
        timeout = 300;
        command = "${pkgs.niri}/bin/niri msg action power-off-monitors";
        # Команда возврата (опционально, но пускай niri знает, что мы активны)
        resumeCommand = "${pkgs.niri}/bin/niri msg action power-on-monitors 2>/dev/null || true";
      }
    ];
  };
}
